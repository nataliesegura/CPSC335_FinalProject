 "messages": [
  {
   "id": "MSG-200",
   "text": "Power out on our whole street since 5 pm, the transformer made a loud pop."
  },
  {
   "id": "MSG-201",
   "text": "I can see sparking at the top of the pole near the school."
  },
  {
   "id": "MSG-202",
   "text": "Tree branch on the wires, line down across the sidewalk. Please hurry."
  },
  {
   "id": "MSG-203",
   "text": "Lights are flickering but not fully out."
  },
  {
   "id": "MSG-204",
   "text": "No power at the clinic, we are running on a generator."
  },
  {
   "id": "MSG-205",
   "text": "Smoke coming from the utility box on the corner, it smells like burning plastic."
  },
  {
   "id": "MSG-206",
   "text": "Still no power. Any update on when it will be back?"
  },
  {
   "id": "MSG-207",
   "text": "Line down in the backyard and the dog is inside. It is sparking a little."
  },
  {
   "id": "MSG-208",
   "text": "Outage at the restaurant, our fridges are getting warm."
  },
  {
   "id": "MSG-209",
   "text": "Heard a bang and then everything went dark on our block."
  },
  {
   "id": "MSG-210",
   "text": "There is a line down on Euclid, cars are driving around it."
  },
  {
   "id": "MSG-211",
   "text": "Power came back for a minute then went out again."
  }
 ],
 "keywords": [
  "line down",
